// Prisma schema สำหรับเว็บ e-learning (Postgres บน Neon)
// ใช้กับ Auth.js (Google + Credentials) และบริการฟรีทั้งหมด

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEARNER
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
}

// ---------- Auth ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?               // null ถ้าสมัครด้วย Google
  image         String?
  phone         String?
  organization  String?               // หน่วยงาน / สังกัด
  position      String?               // ตำแหน่ง
  role          Role      @default(LEARNER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  enrollments  Enrollment[]
  progress     LessonProgress[]
  attempts     QuizAttempt[]
  certificates Certificate[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Content ----------

model Course {
  id           String   @id @default(cuid())
  slug         String   @unique        // ใช้ใน URL เช่น intro-python
  title        String
  summary      String                   // ใช้เป็น meta description
  description  Json?                    // เนื้อหา rich text (Tiptap JSON)
  coverImage   String?
  instructor   String?
  durationMin  Int?
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lessons      Lesson[]
  enrollments  Enrollment[]
  certificates Certificate[]

  @@index([published])
}

model Lesson {
  id         String     @id @default(cuid())
  courseId   String
  title      String
  type       LessonType @default(VIDEO)
  position   Int                          // ลำดับในคอร์ส
  youtubeId  String?                      // เก็บเฉพาะ ID ไม่เก็บ URL เต็ม
  content    Json?                        // เนื้อหาข้อความ (Tiptap JSON)
  attachmentUrl String?                   // ลิงก์ไฟล์แนบ (Drive/R2)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]
  quiz     Quiz?

  @@unique([courseId, position]) // ใช้เป็น index ของ courseId ได้ด้วย
}

// ---------- Quiz ----------

model Quiz {
  id           String @id @default(cuid())
  lessonId     String @unique
  passingScore Int    @default(70)         // เปอร์เซ็นต์ที่ถือว่าผ่าน

  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id          String @id @default(cuid())
  quizId      String
  text        String
  position    Int
  explanation String?

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options Option[]

  @@index([quizId])
}

model Option {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  score     Int                            // เปอร์เซ็นต์
  passed    Boolean
  answers   Json?                          // { questionId: optionId }
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, quizId])
}

// ---------- Learning ----------

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Certificate {
  id       String   @id @default(cuid())
  code     String   @unique              // รหัสตรวจสอบใบประกาศ
  userId   String
  courseId String
  issuedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}
